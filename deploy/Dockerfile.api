# EV2 API (Express + WebSocket notifications)
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:20-alpine
ENV NODE_ENV=production
WORKDIR /app

# Tesseract: lee la foto del ticket o la factura para pre-llenar la entrada de
# mercancia (docs/DECISIONES.md D45). El paquete de espanol NO es opcional -- una
# factura mexicana dice "CANTIDAD", "DESCRIPCION", "IMPORTE", y con el modelo ingles
# solo, las palabras acentuadas se leen mal y la mitad de los renglones se pierden.
# Sin esto instalado la subida sigue funcionando: la foto se guarda como comprobante,
# el renglon queda `failed` diciendo que falta el programa, y la captura sigue a mano.
RUN apk add --no-cache tesseract-ocr tesseract-ocr-data-spa

# Las fotos viven en un volumen, no en la base. Se crea AQUI, y no se deja que Docker
# lo cree al montar: un volumen nombrado sobre una ruta que no existe en la imagen
# nace con dueno root, y este contenedor corre como `node`, que entonces no puede
# escribir y toda subida falla con EACCES.
RUN mkdir -p /app/var/receipts && chown -R node:node /app/var

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY src ./src
COPY migrations ./migrations
# `npm run seed` / `seed:floor` corren dentro de este contenedor (docker compose exec).
COPY seeds ./seeds
# `npm run bootstrap` crea el club y el PRIMER gerente en un servidor nuevo. Sin esto
# dentro de la imagen, un despliegue de produccion no tiene forma de que nadie entre:
# el seed se niega a correr con NODE_ENV=production y /auth/register solo crea invitados.
COPY scripts ./scripts
# The API contract is served at /api/docs and /api/openapi.yaml.
COPY openapi.yaml ./
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/health || exit 1
CMD ["node", "src/index.js"]
