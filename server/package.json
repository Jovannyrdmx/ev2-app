{
  "name": "ev2-server",
  "version": "0.1.0",
  "private": true,
  "description": "EV2 Clandestinoz nightclub management API and realtime server",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "ws": "node src/ws.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node seeds/run.js",
    "test": "jest --runInBand",
    "lint": "eslint src",
    "lint:api": "redocly lint openapi.yaml",
    "test:coverage": "jest --runInBand --coverage",
    "seed:floor": "node seeds/floor-plan.js",
    "seed:prices": "node seeds/price-list.js",
    "seed:menu": "node seeds/menu.js",
    "bootstrap": "node scripts/bootstrap.js",
    "promote": "node scripts/promote.js",
    "seed:supplies": "node seeds/supplies.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js",
      "!src/ws.js",
      "!src/services/*-system.js",
      "!src/services/pos/**"
    ],
    "coverageReporters": [
      "text-summary",
      "text"
    ],
    "coverageThreshold": {
      "./src/routes/": {
        "statements": 70,
        "branches": 60,
        "lines": 70
      }
    },
    "testTimeout": 20000
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.3.0",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "redis": "^4.7.0",
    "stripe": "^17.6.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@redocly/cli": "^2.51.1",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jsdom": "^24.1.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
