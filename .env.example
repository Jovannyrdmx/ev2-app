# ==================== ENVIRONMENT ====================
ENVIRONMENT=development
# development, staging, production

# ==================== DATABASE ====================
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=easyflirt_nightclub

# ==================== REDIS ====================
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== JWT & API KEYS ====================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
API_KEY_SECRET=your-super-secret-api-key-change-in-production

# ==================== URLS ====================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081,https://yournightclub.com
WS_URL=ws://localhost:4000
API_URL=http://localhost:3000
API_HOST=localhost
API_PORT=3000
WS_PORT=4000

# ==================== SOFTRESTAURANT11 INTEGRATION ====================
SOFTRESTAURANT11_URL=http://localhost:8888
SOFTRESTAURANT11_API_KEY=your-softrestaurant11-api-key
SOFTRESTAURANT11_WEBHOOK_SECRET=your-webhook-secret-from-softrestaurant11

# ==================== NIGHTCLUB INFO ====================
NIGHTCLUB_NAME=My Awesome Nightclub
NIGHTCLUB_CITY=Nogales
NIGHTCLUB_COUNTRY=Mexico
NIGHTCLUB_CAPACITY=500

# ==================== FEATURES ====================
ENABLE_BOTTLE_SERVICE=true
ENABLE_VIP_TABLES=true
ENABLE_FLIRT=true
ENABLE_ANALYTICS=true

# ==================== LOGGING ====================
LOG_LEVEL=info
# debug, info, warn, error
