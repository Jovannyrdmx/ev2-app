# ==================== ENVIRONMENT ====================
ENVIRONMENT=development
# development, staging, production

# ==================== DATABASE ====================
DB_USER=postgres
DB_PASSWORD=change-me            # REQUIRED. Use a strong password on servers.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ev2

# ==================== REDIS ====================
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== JWT & API KEYS ====================
JWT_SECRET=change-me             # REQUIRED. Generate with: openssl rand -hex 32
BANK_ENCRYPTION_KEY=change-me    # REQUIRED. Encrypts employee bank accounts. Generate with: openssl rand -hex 32. NEVER rotate without re-encrypting.
API_KEY_SECRET=your-super-secret-api-key-change-in-production

# ==================== URLS ====================
ALLOWED_ORIGINS=http://localhost:8080
WS_URL=ws://localhost:4000
API_URL=http://localhost:3000
API_HOST=localhost
API_PORT=3000
WS_PORT=4000

# ==================== SOFTRESTAURANT11 INTEGRATION ====================
SOFTRESTAURANT11_URL=                # Real value from docs/POS_REAL.md (step 0.9)
SOFTRESTAURANT11_API_KEY=
SOFTRESTAURANT11_WEBHOOK_SECRET=

# ==================== PAGOS: STRIPE ====================
# Se llenan cuando exista la cuenta. Mientras esten vacias, la API responde 501 en las
# rutas de tarjeta y el cobro se hace por pagos manuales (efectivo/transferencia, paso 3.6).
# Donde sacarlas: dashboard.stripe.com -> Developers -> API keys. Ver docs/PAGOS_SETUP.md
# FUERA DE PRODUCCION USA SIEMPRE LAS DE PRUEBA (sk_test_/pk_test_): la API se niega a
# arrancar con llaves live si NODE_ENV no es production.
STRIPE_SECRET_KEY=               # sk_test_... (SECRETA: nunca al navegador, nunca al repo)
STRIPE_PUBLISHABLE_KEY=          # pk_test_... (publica: la usa el navegador)
STRIPE_WEBHOOK_SECRET=           # whsec_...  (firma los webhooks; sin ella se rechazan)

# ==================== PAGOS: MERCADO PAGO ====================
# Donde sacarlas: mercadopago.com.mx/developers -> Tus integraciones -> Credenciales.
# Las de prueba traen el prefijo TEST- en el access token.
MERCADOPAGO_ACCESS_TOKEN=        # TEST-...  (SECRETA)
MERCADOPAGO_PUBLIC_KEY=          # TEST-...  (publica)
MERCADOPAGO_WEBHOOK_SECRET=      # firma de las notificaciones

# ==================== NIGHTCLUB INFO ====================
NIGHTCLUB_NAME=My Awesome Nightclub
NIGHTCLUB_CITY=Nogales
NIGHTCLUB_COUNTRY=Mexico
NIGHTCLUB_CAPACITY=500

# ==================== DEVELOPMENT SEEDS ====================
# Password for the seed users (npm run seed). Development only; never set on servers.
SEED_PASSWORD=

# ==================== FEATURES ====================
ENABLE_BOTTLE_SERVICE=true
ENABLE_VIP_TABLES=true
ENABLE_FLIRT=true
ENABLE_ANALYTICS=true

# ==================== LOGGING ====================
LOG_LEVEL=info
# debug, info, warn, error
