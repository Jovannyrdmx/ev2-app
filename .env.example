# ==================== ENVIRONMENT ====================
ENVIRONMENT=development
# development, staging, production

# ==================== DATABASE ====================
DB_USER=postgres
# REQUIRED. Use a strong password on servers.
# El comentario va en su PROPIA linea: Docker Compose y dotenv cortan el valor en el " #".
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ev2

# ==================== REDIS ====================
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== JWT & API KEYS ====================
# REQUIRED, minimo 16 caracteres. Generate with: openssl rand -hex 32
JWT_SECRET=
# REQUIRED, minimo 32 caracteres. Encrypts employee bank accounts.
# Generate with: openssl rand -hex 32. NEVER rotate without re-encrypting.
BANK_ENCRYPTION_KEY=
API_KEY_SECRET=your-super-secret-api-key-change-in-production

# OBLIGATORIA para el acceso por PIN del personal (D46), minimo 32 caracteres.
# Generala con: openssl rand -base64 48
#
# Con ella se calcula la huella con la que se BUSCA un PIN. Vive aqui y nunca en la
# base a proposito: con la base robada pero sin esta llave, nadie puede recorrer el
# millon de combinaciones para armar la tabla inversa de que PIN es de quien.
#
# NO SE ROTA a la ligera: cambiarla invalida TODOS los PIN del club de golpe y hay que
# generarle uno nuevo a cada empleado.
PIN_LOOKUP_KEY=

# La red del club, para que la gerencia pueda entrar con PIN estando adentro. IPs
# sueltas o bloques CIDR, separados por coma:
#     CLUB_NETWORKS=187.234.11.90,192.168.1.0/24
#
# VACIA = la gerencia no entra con PIN en ningun lado, solo con correo y contrasena.
# Falla hacia el lado seguro a proposito. El personal de piso NO depende de esto:
# ellos entran con su PIN desde donde esten.
CLUB_NETWORKS=

# Intentos de PIN por minuto y por IP. El otro limite, el que de verdad protege, se
# cuenta por CLUB y vive en el codigo (services/pins.js): un atacante con diez
# conexiones se salta el de por IP, pero no el del club.
PIN_RATE_LIMIT_PER_MIN=5

# ==================== URLS ====================
# Origenes del navegador que pueden llamar a la API, separados por coma. Tiene que
# incluir el origen desde el que se sirve la web AUNQUE la API vaya detras del mismo
# proxy: el navegador manda la cabecera Origin tambien en peticiones al mismo origen
# cuando no son GET. Si falta, cada POST responde 403 diciendo exactamente esto.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# La direccion publica con la que el servidor arma los enlaces que SALEN de el: el
# pase que el titular manda por WhatsApp. En tu maquina se deja como esta; en el
# servidor, docker-compose.prod.yml la deduce de EV2_DOMAIN, asi que solo se pone
# aqui si la web vive en un dominio distinto al de la API.
# Nunca se usa la cabecera Host de quien pide: un enlace armado con lo que manda el
# cliente es un enlace a donde ese cliente quiera.
PUBLIC_WEB_URL=http://localhost:8080
WS_URL=ws://localhost:4000
API_URL=http://localhost:3000
API_HOST=localhost
API_PORT=3000
WS_PORT=4000

# ==================== SERVIDOR (solo produccion) ====================
# Los usa deploy/docker-compose.prod.yml y deploy/Caddyfile. En tu maquina se dejan
# vacios; en un servidor son OBLIGATORIOS y el contenedor se niega a arrancar sin ellos.
# El dominio va SIN https:// y sin barra final. Tiene que apuntar ya al servidor con un
# registro A, o Let's Encrypt no puede emitir el certificado.
EV2_DOMAIN=
# Un correo que de verdad leas: Let's Encrypt avisa ahi si un certificado esta por
# vencer y algo fallo.
ACME_EMAIL=
# Para probar sin que entre nadie NO se usa una contrasena de puerta (basic auth usa
# la misma cabecera Authorization que el token de sesion y rompe la app): se cierra el
# puerto 443 a tu IP con el cortafuegos. Ver docs/DESPLIEGUE.md, seccion 3.5.

# ==================== SOFTRESTAURANT11 INTEGRATION ====================
SOFTRESTAURANT11_URL=                # Real value from docs/POS_REAL.md (step 0.9)
SOFTRESTAURANT11_API_KEY=
SOFTRESTAURANT11_WEBHOOK_SECRET=

# ==================== PAGOS: STRIPE ====================
# Se llenan cuando exista la cuenta. Mientras esten vacias, la API responde 501 en las
# rutas de tarjeta y el cobro se hace por pagos manuales (efectivo/transferencia, paso 3.6).
# Donde sacarlas: dashboard.stripe.com -> Developers -> API keys. Ver docs/PAGOS_SETUP.md
# FUERA DE PRODUCCION USA SIEMPRE LAS DE PRUEBA (sk_test_/pk_test_): la API se niega a
# arrancar con llaves live si NODE_ENV no es production.
STRIPE_SECRET_KEY=               # sk_test_... (SECRETA: nunca al navegador, nunca al repo)
STRIPE_PUBLISHABLE_KEY=          # pk_test_... (publica: la usa el navegador)
STRIPE_WEBHOOK_SECRET=           # whsec_...  (firma los webhooks; sin ella se rechazan)

# ==================== PAGOS: MERCADO PAGO ====================
# Donde sacarlas: mercadopago.com.mx/developers -> Tus integraciones -> Credenciales.
# Las de prueba traen el prefijo TEST- en el access token.
MERCADOPAGO_ACCESS_TOKEN=        # TEST-...  (SECRETA)
MERCADOPAGO_PUBLIC_KEY=          # TEST-...  (publica)
MERCADOPAGO_WEBHOOK_SECRET=      # firma de las notificaciones

# ==================== ENTRAR CON FACEBOOK ====================
# Mientras esten vacias, el boton de Facebook NO se pinta en la pantalla de acceso y
# /api/auth/oauth/facebook/start responde 501 diciendo cual de las dos falta. Correo y
# contrasena siguen funcionando igual, con o sin esto.
#
# Donde sacarlas: developers.facebook.com -> Mis apps -> Crear app -> "Autenticacion y
# solicitud de datos de cuenta" -> Configuracion -> Basico. Ver docs/FACEBOOK_LOGIN_SETUP.md
#
# En "Facebook Login -> Configuracion" hay que dar de alta la URI de retorno EXACTA,
# caracter por caracter (la sacas con: docker compose exec api node -e
# "console.log(require('./src/config/oauth').status().providers[0].redirect_uri)"):
#   https://TU-DOMINIO/api/auth/oauth/facebook/callback
# Si no coincide, Facebook rechaza el viaje con un error que habla de la URI.
FACEBOOK_APP_ID=                 # el numero del panel (publico, pero no hace falta en el navegador)
FACEBOOK_APP_SECRET=             # SECRETA: nunca al navegador, nunca al repo
#
# INSTAGRAM no lleva variables a proposito: "Iniciar sesion con Instagram" ya no existe
# para cuentas personales (la Basic Display API se apago el 4 de diciembre de 2024, y sus
# sucesores solo aceptan cuentas Business/Creator y no entregan correo). El proveedor
# queda declarado y apagado en server/src/config/oauth.js con ese motivo escrito.

# ==================== NIGHTCLUB INFO ====================
NIGHTCLUB_NAME=My Awesome Nightclub
NIGHTCLUB_CITY=Nogales
NIGHTCLUB_COUNTRY=Mexico
NIGHTCLUB_CAPACITY=500

# ==================== DEVELOPMENT SEEDS ====================
# Password for the seed users (npm run seed). Development only; never set on servers.
# REQUIRED para `npm run seed`. Minimo 8 caracteres.
SEED_PASSWORD=

# ==================== FEATURES ====================
ENABLE_BOTTLE_SERVICE=true
ENABLE_VIP_TABLES=true
ENABLE_FLIRT=true
ENABLE_ANALYTICS=true

# ==================== LOGGING ====================
LOG_LEVEL=info
# debug, info, warn, error
