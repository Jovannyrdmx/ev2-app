# ==================== ENVIRONMENT ====================
ENVIRONMENT=development
# development, staging, production

# ==================== DATABASE ====================
DB_USER=postgres
# REQUIRED. Use a strong password on servers.
# El comentario va en su PROPIA linea: Docker Compose y dotenv cortan el valor en el " #".
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ev2

# ==================== REDIS ====================
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== JWT & API KEYS ====================
# REQUIRED, minimo 16 caracteres. Generate with: openssl rand -hex 32
JWT_SECRET=
# REQUIRED, minimo 32 caracteres. Encrypts employee bank accounts.
# Generate with: openssl rand -hex 32. NEVER rotate without re-encrypting.
BANK_ENCRYPTION_KEY=
API_KEY_SECRET=your-super-secret-api-key-change-in-production

# ==================== URLS ====================
# Origenes del navegador que pueden llamar a la API, separados por coma. Tiene que
# incluir el origen desde el que se sirve la web AUNQUE la API vaya detras del mismo
# proxy: el navegador manda la cabecera Origin tambien en peticiones al mismo origen
# cuando no son GET. Si falta, cada POST responde 403 diciendo exactamente esto.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
WS_URL=ws://localhost:4000
API_URL=http://localhost:3000
API_HOST=localhost
API_PORT=3000
WS_PORT=4000

# ==================== SERVIDOR (solo produccion) ====================
# Los usa deploy/docker-compose.prod.yml y deploy/Caddyfile. En tu maquina se dejan
# vacios; en un servidor son OBLIGATORIOS y el contenedor se niega a arrancar sin ellos.
# El dominio va SIN https:// y sin barra final. Tiene que apuntar ya al servidor con un
# registro A, o Let's Encrypt no puede emitir el certificado.
EV2_DOMAIN=
# Un correo que de verdad leas: Let's Encrypt avisa ahi si un certificado esta por
# vencer y algo fallo.
ACME_EMAIL=
# Que configuracion de Caddy usar. Vacio = sitio ABIERTO (el estreno).
# Pon ./Caddyfile.privado para dejarlo CERRADO con contrasena de puerta mientras
# pruebas: nadie ve una sola pantalla sin ella. Instrucciones en deploy/Caddyfile.pruebas.
CADDYFILE=

# ==================== SOFTRESTAURANT11 INTEGRATION ====================
SOFTRESTAURANT11_URL=                # Real value from docs/POS_REAL.md (step 0.9)
SOFTRESTAURANT11_API_KEY=
SOFTRESTAURANT11_WEBHOOK_SECRET=

# ==================== PAGOS: STRIPE ====================
# Se llenan cuando exista la cuenta. Mientras esten vacias, la API responde 501 en las
# rutas de tarjeta y el cobro se hace por pagos manuales (efectivo/transferencia, paso 3.6).
# Donde sacarlas: dashboard.stripe.com -> Developers -> API keys. Ver docs/PAGOS_SETUP.md
# FUERA DE PRODUCCION USA SIEMPRE LAS DE PRUEBA (sk_test_/pk_test_): la API se niega a
# arrancar con llaves live si NODE_ENV no es production.
STRIPE_SECRET_KEY=               # sk_test_... (SECRETA: nunca al navegador, nunca al repo)
STRIPE_PUBLISHABLE_KEY=          # pk_test_... (publica: la usa el navegador)
STRIPE_WEBHOOK_SECRET=           # whsec_...  (firma los webhooks; sin ella se rechazan)

# ==================== PAGOS: MERCADO PAGO ====================
# Donde sacarlas: mercadopago.com.mx/developers -> Tus integraciones -> Credenciales.
# Las de prueba traen el prefijo TEST- en el access token.
MERCADOPAGO_ACCESS_TOKEN=        # TEST-...  (SECRETA)
MERCADOPAGO_PUBLIC_KEY=          # TEST-...  (publica)
MERCADOPAGO_WEBHOOK_SECRET=      # firma de las notificaciones

# ==================== NIGHTCLUB INFO ====================
NIGHTCLUB_NAME=My Awesome Nightclub
NIGHTCLUB_CITY=Nogales
NIGHTCLUB_COUNTRY=Mexico
NIGHTCLUB_CAPACITY=500

# ==================== DEVELOPMENT SEEDS ====================
# Password for the seed users (npm run seed). Development only; never set on servers.
# REQUIRED para `npm run seed`. Minimo 8 caracteres.
SEED_PASSWORD=

# ==================== FEATURES ====================
ENABLE_BOTTLE_SERVICE=true
ENABLE_VIP_TABLES=true
ENABLE_FLIRT=true
ENABLE_ANALYTICS=true

# ==================== LOGGING ====================
LOG_LEVEL=info
# debug, info, warn, error
